+/* curl-impersonate: the size of a CRYPTO frame header, quiche's
+   QuicFramer::GetMinCryptoFrameSize(). */
+static size_t crypto_frame_overhead(uint64_t offset, uint64_t len) {
+  return 1 + ngtcp2_put_uvarintlen(offset) + ngtcp2_put_uvarintlen(len);
+}
+
+/*
+ * curl-impersonate: conn_chaos_protect lays out an Initial packet like
+ * Chrome's chaos protection (quiche's QuicChaosProtector).  The
+ * |datacnt| CRYPTO frames in |data| and |offsets| leave |padding| bytes
+ * of the packet.  2 to 10 times a random frame is split at a random
+ * point while the padding pays for the frame headers, 2 to 10 PING
+ * frames are added, a random part of the remaining padding goes before
+ * each frame as a PADDING frame and the rest after the last one, and
+ * all frames are shuffled.  A PING frame is {NULL, 0}, a PADDING frame
+ * {NULL, length}.  This function returns the number of frames.
+ */
+static size_t conn_chaos_protect(ngtcp2_conn *conn, ngtcp2_vec *data,
+                                 uint64_t *offsets, size_t datacnt,
+                                 size_t padding) {
+  ngtcp2_vec frames[64];
+  uint64_t frame_offsets[64];
+  uint64_t begin = UINT64_MAX, end = 0, o;
+  size_t max_overhead, overhead, len, n, i, j;
+  ngtcp2_vec v;
+
+  if (padding == 0 || datacnt > 32) {
+    return datacnt;
+  }
+
+  for (i = 0; i < datacnt; ++i) {
+    begin = ngtcp2_min_uint64(begin, offsets[i]);
+    end = ngtcp2_max_uint64(end, offsets[i] + data[i].len);
+  }
+
+  /* SplitCryptoFrame */
+  max_overhead = crypto_frame_overhead(end, end - begin);
+  n = 2 + ngtcp2_pcg32_rand_n(&conn->pcg, 9);
+  for (j = 0; j < n && padding >= max_overhead; ++j) {
+    i = ngtcp2_pcg32_rand_n(&conn->pcg, (uint32_t)datacnt);
+    if (data[i].len <= 1) {
+      continue;
+    }
+
+    overhead = crypto_frame_overhead(offsets[i], data[i].len);
+    len = 1 + ngtcp2_pcg32_rand_n(&conn->pcg, (uint32_t)(data[i].len - 1));
+    data[datacnt] = (ngtcp2_vec){
+      .base = data[i].base + len,
+      .len = data[i].len - len,
+    };
+    offsets[datacnt] = offsets[i] + len;
+    data[i].len = len;
+    padding = padding + overhead -
+              crypto_frame_overhead(offsets[i], data[i].len) -
+              crypto_frame_overhead(offsets[datacnt], data[datacnt].len);
+    ++datacnt;
+  }
+
+  /* AddPingFrames */
+  if (padding) {
+    n = ngtcp2_min_size(2 + ngtcp2_pcg32_rand_n(&conn->pcg, 9), padding);
+    for (j = 0; j < n; ++j) {
+      data[datacnt] = (ngtcp2_vec){
+        .base = NULL,
+        .len = 0,
+      };
+      offsets[datacnt++] = 0;
+    }
+    padding -= n;
+  }
+
+  /* SpreadPadding */
+  memcpy(frames, data, sizeof(frames[0]) * datacnt);
+  memcpy(frame_offsets, offsets, sizeof(frame_offsets[0]) * datacnt);
+  n = datacnt;
+  datacnt = 0;
+  for (i = 0; i < n; ++i) {
+    len = ngtcp2_pcg32_rand_n(&conn->pcg, (uint32_t)(padding + 1));
+    if (len) {
+      data[datacnt] = (ngtcp2_vec){
+        .base = NULL,
+        .len = len,
+      };
+      offsets[datacnt++] = 0;
+      padding -= len;
+    }
+    data[datacnt] = frames[i];
+    offsets[datacnt++] = frame_offsets[i];
+  }
+  if (padding) {
+    data[datacnt] = (ngtcp2_vec){
+      .base = NULL,
+      .len = padding,
+    };
+    offsets[datacnt++] = 0;
+  }
+
+  /* ReorderFrames */
+  for (i = datacnt - 1; i > 0; --i) {
+    j = ngtcp2_pcg32_rand_n(&conn->pcg, (uint32_t)(i + 1));
+    v = data[i];
+    data[i] = data[j];
+    data[j] = v;
+    o = offsets[i];
+    offsets[i] = offsets[j];
+    offsets[j] = o;
+  }
+
+  return datacnt;
+}
