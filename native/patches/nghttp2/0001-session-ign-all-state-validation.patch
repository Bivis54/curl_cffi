Fix missing iframe->state validation to avoid assertion failure (CVE-2026-27135)

Backport of nghttp2 commit 5c7df8fa815ac1004d9ecb9d1f7595c4d37f46e1 to 1.63.0.
When nghttp2_session_mem_recv2 internally terminates the session it sets the
inbound state to NGHTTP2_IB_IGN_ALL, but kept processing the rest of the input;
a following malformed frame that raises FRAME_SIZE_ERROR then trips an
assertion (a denial of service). Return after each step that may have
terminated the session, as upstream does. nghttp2 stays at 1.63.0 so the
HTTP/2 output is byte-identical; 1.68.1 adopts the shared sfparse symbol names
that collide with nghttp3 at static link time. The on_data_chunk_recv guard is
placed after the callback's error checks, which 1.63.0 orders differently.

diff --git a/lib/nghttp2_session.c b/lib/nghttp2_session.c
--- a/lib/nghttp2_session.c
+++ b/lib/nghttp2_session.c
@@ -6082,6 +6082,10 @@
           return rv;
         }
 
+        if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+          return (nghttp2_ssize)inlen;
+        }
+
         on_begin_frame_called = 1;
 
         rv = session_process_headers_frame(session);
@@ -6448,6 +6452,10 @@
           if (nghttp2_is_fatal(rv)) {
             return rv;
           }
+
+          if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+            return (nghttp2_ssize)inlen;
+          }
         }
       }
 
@@ -6704,6 +6712,10 @@
           return rv;
         }
 
+        if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+          return (nghttp2_ssize)inlen;
+        }
+
         session_inbound_frame_reset(session);
 
         break;
@@ -7007,6 +7019,10 @@
         if (nghttp2_is_fatal(rv)) {
           return rv;
         }
+
+        if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+          return (nghttp2_ssize)inlen;
+        }
       } else {
         iframe->state = NGHTTP2_IB_IGN_HEADER_BLOCK;
       }
@@ -7179,6 +7195,10 @@
             if (nghttp2_is_fatal(rv)) {
               return NGHTTP2_ERR_CALLBACK_FAILURE;
             }
+
+            if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+              return (nghttp2_ssize)inlen;
+            }
           }
         }
       }
@@ -7259,6 +7279,10 @@
           return rv;
         }
 
+        if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+          return (nghttp2_ssize)inlen;
+        }
+
         if (rv != 0) {
           busy = 1;
 
@@ -7277,6 +7301,10 @@
         return rv;
       }
 
+      if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+        return (nghttp2_ssize)inlen;
+      }
+
       session_inbound_frame_reset(session);
 
       break;
@@ -7305,6 +7333,10 @@
         return rv;
       }
 
+      if (iframe->state == NGHTTP2_IB_IGN_ALL) {
+        return (nghttp2_ssize)inlen;
+      }
+
       session_inbound_frame_reset(session);
 
       break;
