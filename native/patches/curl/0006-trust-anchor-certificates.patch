tls: hold the certificates behind advertised trust anchor IDs

diff --git a/lib/Makefile.inc b/lib/Makefile.inc
index a314f15..459ae42 100644
--- a/lib/Makefile.inc
+++ b/lib/Makefile.inc
@@ -133,6 +133,7 @@ LIB_VTLS_HFILES =           \
   vtls/rustls.h             \
   vtls/schannel.h           \
   vtls/schannel_int.h       \
+  vtls/trust_anchor_certs.h \
   vtls/vtls.h               \
   vtls/vtls_config.h        \
   vtls/vtls_int.h           \
diff --git a/lib/vtls/openssl.c b/lib/vtls/openssl.c
index dee15c3..0c07af9 100644
--- a/lib/vtls/openssl.c
+++ b/lib/vtls/openssl.c
@@ -3411,6 +3411,67 @@ static CURLcode ossl_load_trust_anchors(struct Curl_cfilter *cf,
   return result;
 }
 
+#ifdef OPENSSL_IS_BORINGSSL
+#include "trust_anchor_certs.h"
+
+static bool ossl_trust_anchor_listed(const char *anchors, const char *id)
+{
+  size_t id_len = strlen(id);
+
+  while(*anchors) {
+    const char *end;
+    const char *last;
+
+    while((*anchors == ' ') || (*anchors == '\t') || (*anchors == ','))
+      anchors++;
+    end = anchors;
+    while(*end && (*end != ','))
+      end++;
+    last = end;
+    while((last > anchors) && ((last[-1] == ' ') || (last[-1] == '\t')))
+      last--;
+    if(((size_t)(last - anchors) == id_len) && !memcmp(anchors, id, id_len))
+      return TRUE;
+    anchors = end;
+  }
+  return FALSE;
+}
+
+/* curl-impersonate: hold the certificates behind the trust anchor IDs we
+ * send. Chrome's root store makes some intermediates trust anchors, and
+ * servers leave them out of the chain for clients that advertise their IDs
+ * (Google does over QUIC). CA bundles only have the roots. */
+static void ossl_add_trust_anchor_certs(struct Curl_easy *data,
+                                        X509_STORE *store,
+                                        const char *anchors)
+{
+  size_t added = 0;
+  size_t i;
+
+  for(i = 0; i < CURL_ARRAYSIZE(ossl_trust_anchor_certs); i++) {
+    const struct ossl_trust_anchor_cert *tac = &ossl_trust_anchor_certs[i];
+    BIO *bio;
+    X509 *x509;
+
+    if(!ossl_trust_anchor_listed(anchors, tac->id))
+      continue;
+    bio = BIO_new_mem_buf(tac->pem, -1);
+    if(!bio)
+      break;
+    x509 = PEM_read_bio_X509(bio, NULL, NULL, NULL);
+    BIO_free(bio);
+    if(x509 && X509_STORE_add_cert(store, x509))
+      added++;
+    else
+      infof(data, "  error adding the certificate of trust anchor %s",
+            tac->id);
+    X509_free(x509);
+  }
+  if(added)
+    infof(data, "  %zu certificates of advertised trust anchor IDs", added);
+}
+#endif /* OPENSSL_IS_BORINGSSL */
+
 static CURLcode ossl_populate_x509_store(struct Curl_cfilter *cf,
                                          struct Curl_easy *data,
                                          struct ossl_ctx *octx,
@@ -3437,6 +3498,11 @@ static CURLcode ossl_populate_x509_store(struct Curl_cfilter *cf,
   if(result)
     return result;
 
+#ifdef OPENSSL_IS_BORINGSSL
+  if(conn_config->trust_anchors && conn_config->trust_anchors[0])
+    ossl_add_trust_anchor_certs(data, store, conn_config->trust_anchors);
+#endif
+
   /* Does not make sense to load a CRL file without peer verification */
   if(ssl_crlfile) {
     /* tell OpenSSL where to find CRL file that is used to check certificate
@@ -3479,6 +3545,7 @@ static CURLcode ossl_populate_x509_store(struct Curl_cfilter *cf,
 
 struct ossl_x509_share {
   char *CAfile;         /* CAfile path used to generate X509 store */
+  char *trust_anchors;  /* trust anchor IDs whose certificates were added */
   X509_STORE *store;    /* cached X509 store or NULL if none */
   struct curltime time; /* when the cached store was created */
   BIT(store_is_empty);  /* no certs/paths/blobs are in the store */
@@ -3496,6 +3563,7 @@ static void oss_x509_share_free(void *key, size_t key_len, void *p)
     X509_STORE_free(share->store);
   }
   curlx_free(share->CAfile);
+  curlx_free(share->trust_anchors);
   curlx_free(share);
 }
 
@@ -3522,6 +3590,9 @@ static bool ossl_cached_x509_store_different(struct Curl_cfilter *cf,
     Curl_ssl_cf_get_config(cf, CURL_UNCONST(data));
   if(mb->no_partialchain != ssl_config->no_partialchain)
     return TRUE;
+  if(strcmp(mb->trust_anchors ? mb->trust_anchors : "",
+            conn_config->trust_anchors ? conn_config->trust_anchors : ""))
+    return TRUE;
   if(!mb->CAfile || !conn_config->CAfile)
     return mb->CAfile != conn_config->CAfile;
   return strcmp(mb->CAfile, conn_config->CAfile);
@@ -3581,6 +3652,7 @@ static void ossl_set_cached_x509_store(struct Curl_cfilter *cf,
 
   if(X509_STORE_up_ref(store)) {
     char *CAfile = NULL;
+    char *trust_anchors = NULL;
     struct ssl_config_data *ssl_config =
       Curl_ssl_cf_get_config(cf, CURL_UNCONST(data));
 
@@ -3591,16 +3663,26 @@ static void ossl_set_cached_x509_store(struct Curl_cfilter *cf,
         return;
       }
     }
+    if(conn_config->trust_anchors && conn_config->trust_anchors[0]) {
+      trust_anchors = curlx_strdup(conn_config->trust_anchors);
+      if(!trust_anchors) {
+        curlx_free(CAfile);
+        X509_STORE_free(store);
+        return;
+      }
+    }
 
     if(share->store) {
       X509_STORE_free(share->store);
       curlx_free(share->CAfile);
+      curlx_free(share->trust_anchors);
     }
 
     share->time = *Curl_pgrs_now(data);
     share->store = store;
     share->store_is_empty = is_empty;
     share->CAfile = CAfile;
+    share->trust_anchors = trust_anchors;
     share->no_partialchain = ssl_config->no_partialchain;
   }
 }
