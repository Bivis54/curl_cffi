dns: no local HTTPS-RR queries for origins behind a proxy

diff --git a/lib/vdns/cf-dns.c b/lib/vdns/cf-dns.c
index 8a08912..9fe7dff 100644
--- a/lib/vdns/cf-dns.c
+++ b/lib/vdns/cf-dns.c
@@ -640,6 +640,19 @@ CURLcode Curl_conn_dns_add_https_resolve(struct Curl_easy *data,
                                          int8_t sockindex,
                                          struct Curl_peer *peer)
 {
+#ifndef CURL_DISABLE_PROXY
+  /* curl-impersonate: behind a proxy, the proxy resolves the origin. A local
+   * HTTPS-RR query would leak it to the local resolver, and a browser behind
+   * a proxy has no HTTPS-RR (ALPN, ECH) data either. */
+  if((conn->socks_proxy.peer &&
+      !Curl_peer_same_destination(peer, conn->socks_proxy.peer)) ||
+     (conn->http_proxy.peer &&
+      !Curl_peer_same_destination(peer, conn->http_proxy.peer))) {
+    CURL_TRC_DNS(data, "no HTTPS-RR query for %s:%u behind a proxy",
+                 peer->hostname, peer->port);
+    return CURLE_OK;
+  }
+#endif
   return cf_dns_add_resolve(data, conn, sockindex, peer,
                             CURL_DNSQ_HTTPS, conn->transport_wanted);
 }
