+#ifdef USE_HTTP3
+CURLcode Curl_ssl_scache_quic_put(struct Curl_cfilter *cf,
+                                  struct Curl_easy *data,
+                                  const char *ssl_peer_key,
+                                  const unsigned char *token,
+                                  size_t token_len,
+                                  uint64_t srtt_us)
+{
+  struct Curl_ssl_scache *scache = cf_ssl_scache_get(data);
+  struct ssl_primary_config *conn_config = Curl_ssl_cf_get_primary_config(cf);
+  struct Curl_ssl_scache_peer *peer = NULL;
+  CURLcode result;
+
+  if(!scache || !Curl_ssl_scache_use(cf, data))
+    return CURLE_OK;
+
+  Curl_ssl_scache_lock(data);
+  result = cf_ssl_add_peer(data, scache, ssl_peer_key, conn_config, &peer);
+  if(!result && peer) {
+    if(token && token_len) {
+      unsigned char *copy = curlx_memdup(token, token_len);
+      if(!copy)
+        result = CURLE_OUT_OF_MEMORY;
+      else {
+        curlx_free(peer->quic_token);
+        peer->quic_token = copy;
+        peer->quic_token_len = token_len;
+      }
+    }
+    if(srtt_us)
+      peer->quic_srtt_us = srtt_us;
+  }
+  Curl_ssl_scache_unlock(data);
+  return result;
+}
+
+bool Curl_ssl_scache_quic_get(struct Curl_cfilter *cf,
+                              struct Curl_easy *data,
+                              const char *ssl_peer_key,
+                              struct dynbuf *token,
+                              uint64_t *psrtt_us)
+{
+  struct Curl_ssl_scache *scache = cf_ssl_scache_get(data);
+  struct ssl_primary_config *conn_config = Curl_ssl_cf_get_primary_config(cf);
+  struct Curl_ssl_scache_peer *peer = NULL;
+  bool found = FALSE;
+
+  curlx_dyn_reset(token);
+  *psrtt_us = 0;
+  if(!scache || !Curl_ssl_scache_use(cf, data))
+    return FALSE;
+
+  Curl_ssl_scache_lock(data);
+  if(!cf_ssl_find_peer_by_key(data, scache, ssl_peer_key, conn_config,
+                              &peer) && peer) {
+    if(peer->quic_token_len &&
+       curlx_dyn_addn(token, peer->quic_token, peer->quic_token_len))
+      curlx_dyn_reset(token);
+    *psrtt_us = peer->quic_srtt_us;
+    found = curlx_dyn_len(token) || peer->quic_srtt_us;
+  }
+  Curl_ssl_scache_unlock(data);
+  return found;
+}
