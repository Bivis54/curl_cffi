+/* curl-impersonate: like Chromium, announce a request priority other than
+ * the default "u=3" in a PRIORITY_UPDATE frame on the control stream. */
+void Curl_cf_ngtcp2_h3_send_priority(struct Curl_cfilter *cf,
+                                     struct Curl_easy *data,
+                                     int64_t stream_id,
+                                     const nghttp3_nv *nva, size_t nvlen)
+{
+  struct cf_ngtcp2_ctx *ctx = cf->ctx;
+  size_t i;
+
+  if(!data->set.http3_priority_update)
+    return;
+  for(i = 0; i < nvlen; ++i) {
+    if((nva[i].namelen == 8) && !memcmp(nva[i].name, "priority", 8)) {
+      if(!((nva[i].valuelen == 3) && !memcmp(nva[i].value, "u=3", 3))) {
+        int rc = nghttp3_conn_set_client_stream_priority(
+          ctx->h3conn, stream_id, nva[i].value, nva[i].valuelen);
+        if(rc)
+          CURL_TRC_CF(data, cf, "[%" PRId64 "] no "
+                      "PRIORITY_UPDATE: %s", stream_id, nghttp3_strerror(rc));
+      }
+      return;
+    }
+  }
+}
+
+/* curl-impersonate: ngtcp2 has dropped all streams of the rejected 0-RTT
+ * data. Drop the HTTP/3 layer as well, it is set up again with the 1-RTT
+ * keys and the requests are sent again once the handshake is done. */
+static int cb_tls_early_data_rejected(ngtcp2_conn *tconn, void *user_data)
+{
+  struct Curl_cfilter *cf = user_data;
+  struct cf_ngtcp2_ctx *ctx = cf ? cf->ctx : NULL;
+  struct Curl_easy *data = cf ? CF_DATA_CURRENT(cf) : NULL;
+
+  (void)tconn;
+  if(!ctx)
+    return NGTCP2_ERR_CALLBACK_FAILURE;
+  if(data)
+    CURL_TRC_CF(data, cf, "server rejected early data");
+  ctx->earlydata_rejected = TRUE;
+  if(ctx->h3conn) {
+    nghttp3_conn_del(ctx->h3conn);
+    ctx->h3conn = NULL;
+  }
+  return 0;
+}
+
+/* curl-impersonate: keep the server's address token for the next
+ * connection, as browsers do. */
+static int cb_recv_new_token(ngtcp2_conn *tconn, const uint8_t *token,
+                             size_t tokenlen, void *user_data)
+{
+  struct Curl_cfilter *cf = user_data;
+  struct cf_ngtcp2_ctx *ctx = cf ? cf->ctx : NULL;
+  struct Curl_easy *data = cf ? CF_DATA_CURRENT(cf) : NULL;
+
+  (void)tconn;
+  if(ctx && data && data->set.quic_address_token &&
+     ctx->ssl_peer.scache_key) {
+    CURL_TRC_CF(data, cf, "received %zu bytes address token", tokenlen);
+    (void)Curl_ssl_scache_quic_put(cf, data, ctx->ssl_peer.scache_key,
+                                   token, tokenlen, 0);
+  }
+  return 0;
+}
