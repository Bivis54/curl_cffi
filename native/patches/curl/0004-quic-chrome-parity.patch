+struct cf_ngtcp2_resubmit {
+  struct Curl_cfilter *cf;
+  struct Curl_easy *data;
+};
+
+/* Send a request again whose 0-RTT copy the server did not accept. */
+static bool cf_ngtcp2_resubmit_early(uint32_t mid, void *value,
+                                     void *user_data)
+{
+  struct cf_ngtcp2_resubmit *r = user_data;
+  struct cf_ngtcp2_ctx *ctx = r->cf->ctx;
+  struct h3_stream_ctx *stream = value;
+  struct Curl_easy *sdata = Curl_multi_get_easy(r->data->multi, mid);
+  nghttp3_nv *nva = NULL;
+  size_t nheader, i;
+  int64_t sid;
+  int rc;
+
+  if(!stream->early_hds)
+    return TRUE;
+  if(!sdata || !ctx->h3conn)
+    goto fail;
+  nheader = Curl_dynhds_count(stream->early_hds);
+  nva = curlx_malloc(sizeof(nghttp3_nv) * nheader);
+  if(!nva)
+    goto fail;
+  for(i = 0; i < nheader; ++i) {
+    struct dynhds_entry *e = Curl_dynhds_getn(stream->early_hds, i);
+    nva[i].name = (unsigned char *)e->name;
+    nva[i].namelen = e->namelen;
+    nva[i].value = (unsigned char *)e->value;
+    nva[i].valuelen = e->valuelen;
+    nva[i].flags = NGHTTP3_NV_FLAG_NONE;
+  }
+  rc = ngtcp2_conn_open_bidi_stream(ctx->qconn, &sid, sdata);
+  if(!rc)
+    rc = nghttp3_conn_submit_request(ctx->h3conn, sid, nva, nheader, NULL,
+                                     sdata);
+  if(rc) {
+    curlx_free(nva);
+    goto fail;
+  }
+  CURL_TRC_CF(r->data, r->cf, "[%" PRId64 "] 0-RTT request sent again on "
+              "stream %" PRId64, stream->id, sid);
+  stream->id = sid;
+  Curl_cf_ngtcp2_h3_send_priority(r->cf, sdata, sid, nva, nheader);
+  curlx_free(nva);
+  Curl_dynhds_free(stream->early_hds);
+  curlx_safefree(stream->early_hds);
+  return TRUE;
+
+fail:
+  /* let the transfer retry the request */
+  stream->reset = TRUE;
+  stream->closed = TRUE;
+  stream->error3 = CURL_H3_ERR_REQUEST_REJECTED;
+  Curl_dynhds_free(stream->early_hds);
+  curlx_safefree(stream->early_hds);
+  return TRUE;
+}
+
+static bool cf_ngtcp2_forget_early(uint32_t mid, void *value,
+                                   void *user_data)
+{
+  struct h3_stream_ctx *stream = value;
+  (void)mid;
+  (void)user_data;
+  if(stream->early_hds) {
+    Curl_dynhds_free(stream->early_hds);
+    curlx_safefree(stream->early_hds);
+  }
+  return TRUE;
+}
+
+/* curl-impersonate: remember the smoothed RTT for the next connection to
+ * this server, which sends it as initial_rtt transport parameter. */
+void Curl_cf_ngtcp2_remember_rtt(struct Curl_cfilter *cf,
+                                 struct Curl_easy *data)
+{
+  struct cf_ngtcp2_ctx *ctx = cf->ctx;
+  ngtcp2_conn_info info;
+  uint64_t srtt_us;
+
+  if(!ctx || !ctx->qconn || !ctx->ssl_peer.scache_key)
+    return;
+  ngtcp2_conn_get_conn_info(ctx->qconn, &info);
+  srtt_us = info.smoothed_rtt / NGTCP2_MICROSECONDS;
+  if(srtt_us)
+    (void)Curl_ssl_scache_quic_put(cf, data, ctx->ssl_peer.scache_key,
+                                   NULL, 0, srtt_us);
+}
