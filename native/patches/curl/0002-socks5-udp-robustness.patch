+/* curl-impersonate: strip SOCKS5 UDP headers before passing QUIC payloads
+ * upward, one datagram per call. */
+static CURLcode socks_proxy_cf_recv(struct Curl_cfilter *cf,
+                                    struct Curl_easy *data,
+                                    char *buf, size_t len, size_t *pnread)
+{
+  struct socks_ctx *sx = cf->ctx;
+  const size_t max_header = SOCKS5_HEADER_LEN + 1 + 255 + SOCKS5_PORT_LEN;
+  const unsigned char *p;
+  size_t left, seg_len, hlen;
+
+  *pnread = 0;
+  if(!sx || !sx->udp_associate)
+    return Curl_cf_def_recv(cf, data, buf, len, pnread);
+
+  if(!sx->udp_batch) {
+    unsigned char *packet;
+    size_t packet_len, nread = 0;
+    CURLcode result;
+
+    if(len > SIZE_MAX - max_header)
+      return CURLE_OUT_OF_MEMORY;
+    packet_len = len + max_header;
+    packet = curlx_malloc(packet_len);
+    if(!packet)
+      return CURLE_OUT_OF_MEMORY;
+    result = cf->next->cft->do_recv(cf->next, data, (char *)packet,
+                                    packet_len, &nread);
+    if(result) {
+      curlx_free(packet);
+      return result;
+    }
+    hlen = socks5_udp_header_len(packet, nread);
+    if(!hlen) {
+      /* RFC 1928: drop what we cannot use instead of failing the
+       * connection, e.g. fragments or stray datagrams. */
+      CURL_TRC_CF(data, cf, "dropped SOCKS5 UDP datagram of %zu bytes",
+                  nread);
+      curlx_free(packet);
+      return CURLE_OK;
+    }
+
+    /* curl-impersonate: an association carries a single destination, so
+     * the QUIC path stays the one the connection started with. Relays
+     * differ in what they put into the reply header (the origin, themselves,
+     * zeros, an IPv4-mapped address or a name); following it would make
+     * ngtcp2 drop the packets as coming from an unknown path. */
+    if(!sx->udp_src_seen) {
+      sx->udp_src_seen = TRUE;
+      socks5_udp_trace_src(cf, data, packet[3], &packet[SOCKS5_HEADER_LEN],
+                           (int)((packet[hlen - 2] << 8) | packet[hlen - 1]));
+    }
+
+    sx->udp_batch = packet;
+    sx->udp_batch_len = nread;
+    sx->udp_batch_off = 0;
+    sx->udp_batch_seg = socks5_udp_segment_size(packet, nread, hlen);
+    if(sx->udp_batch_seg && !sx->udp_batch_seen) {
+      sx->udp_batch_seen = TRUE;
+      infof(data, "SOCKS5 UDP relay batches datagrams of %zu bytes, "
+            "splitting them", sx->udp_batch_seg);
+    }
   }
 
