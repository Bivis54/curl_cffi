+/* curl-impersonate: some relays hand over a batch of datagrams (GSO
+ * segments) as one oversized UDP datagram. Each segment is a complete SOCKS5
+ * UDP datagram from the same source, so it starts with the same header, and
+ * all segments but the last have the same size. Return that size, or 0 when
+ * `p` holds a single datagram. */
+static size_t socks5_udp_segment_size(const unsigned char *p, size_t len,
+                                      size_t hlen)
+{
+  size_t seg, off;
+
+  for(seg = hlen + 1; seg + hlen <= len; seg++) {
+    if(memcmp(p + seg, p, hlen))
+      continue;
+    for(off = 2 * seg; off < len; off += seg) {
+      if((len - off < hlen) || memcmp(p + off, p, hlen))
+        break;
+    }
+    if(off >= len)
+      return seg;
   }
+  return 0;
+}
 
