+++ b/lib/easy.c
@@ -657,6 +657,8 @@ static CURLcode _do_impersonate(struct Curl_easy *data,
     ret = curl_easy_setopt(data, CURLOPT_STREAM_WEIGHT, opts->http2_stream_weight);
     if(ret)
       return ret;
+    /* the profile's weight is a default, not the application's choice */
+    data->set.stream_weight_set = FALSE;
   }
 
   if(opts->http2_stream_exclusive) {
