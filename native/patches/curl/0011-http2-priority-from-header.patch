 }
 
+/* curl-impersonate: the urgency (RFC 9218) of a "priority" header value, 3
+   when it has none or an invalid one. */
+static int h2_priority_urgency(const char *value, size_t len)
+{
+  const char *end = value + len;
+  int urgency = 3;
+
+  while(value < end) {
+    const char *key;
+
+    while(value < end && (ISBLANK(*value) || *value == ','))
+      value++;
+    key = value;
+    while(value < end && *value != '=' && *value != ',' && *value != ';')
+      value++;
+    if(((value - key) == 1) && (*key == 'u') && ((end - value) >= 2) &&
+       (*value == '=') && ISDIGIT(value[1]) && (value[1] <= '7') &&
+       (((end - value) == 2) || !ISDIGIT(value[2])))
+      urgency = value[1] - '0';
+    while(value < end && *value != ',')
+      value++;
+  }
+  return urgency;
+}
+
+struct h2_open_stream_search {
+  int32_t id; /* parent so far, 0 for none */
+  uint8_t prio; /* the parent's priority */
+  uint8_t lowest; /* the new stream's priority, the lowest to match */
+};
+
+static bool h2_find_open_stream(uint32_t mid, void *value, void *user_data)
+{
+  const struct h2_stream_ctx *stream = value;
+  struct h2_open_stream_search *search = user_data;
+
+  (void)mid;
+  if((stream->id <= 0) || stream->closed || (stream->prio > search->lowest))
+    return TRUE;
+  if(!search->id || (stream->prio > search->prio) ||
+     ((stream->prio == search->prio) && (stream->id > search->id))) {
+    search->id = stream->id;
+    search->prio = stream->prio;
+  }
+  return TRUE;
+}
+
+/* curl-impersonate: Chrome sets the HEADERS priority from the request's
+ * priority p, which its "priority: u=p" header carries: the weight is
+ * round(1 + (7 - p) * 255 / 7) and the stream depends exclusively on the
+ * newest stream still open with priority p; only without one on the newest
+ * open stream of the nearest higher priority, else on 0 (Chromium's
+ * Http2PriorityDependencies). A CURLOPT_STREAM_WEIGHT set by the
+ * application keeps its weight. A request without the header keeps the
+ * profile's priority and counts as priority 0 for the streams after it.
+ * Only profiles with Chrome's exclusive priorities do this. */
+static void h2_pri_spec_from_header(struct cf_h2_ctx *ctx,
+                                    struct Curl_easy *data,
+                                    struct h2_stream_ctx *stream,
+                                    struct dynhds *h2_headers,
+                                    nghttp2_priority_spec *pri_spec)
+{
+  static const int weights[8] = { 256, 220, 183, 147, 110, 74, 37, 1 };
+  struct h2_open_stream_search search;
+  struct dynhds_entry *e;
+
+  if(!data->set.stream_exclusive || data->set.http2_no_priority)
+    return;
+  e = Curl_dynhds_cget(h2_headers, "priority");
+  if(!e)
+    return;
+  stream->prio = (uint8_t)h2_priority_urgency(e->value, e->valuelen);
+  search.id = 0;
+  search.prio = 0;
+  search.lowest = stream->prio;
+  Curl_uint32_hash_visit(&ctx->streams, h2_find_open_stream, &search);
+  nghttp2_priority_spec_init(pri_spec, search.id,
+                             data->set.stream_weight_set ?
+                             data->set.weight : weights[stream->prio], 1);
+}
+
 /*
  * Check if there is been an update in the priority /
  * dependency settings and if so it submits a PRIORITY frame with the updated
@@ -2289,6 +2371,7 @@ static CURLcode h2_submit(struct h2_stream_ctx **pstream,
   }
 
   h2_pri_spec(data, &pri_spec);
+  h2_pri_spec_from_header(ctx, data, stream, &h2_headers, &pri_spec);
   if(!nghttp2_session_check_request_allowed(ctx->h2))
     CURL_TRC_CF(data, cf, "send request NOT allowed (via nghttp2)");
 
