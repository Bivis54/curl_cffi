http: send the application's Connection: header in place, without duplicate tokens

Since curl 8.16 (4d040c71d7, "Curl_http(), decomplexify") the custom
headers skip Connection: and http_add_connection_hd() writes the first one
after all other headers, followed by curl's own TE, Upgrade and
HTTP2-Settings tokens without checking the value. A WebSocket handshake with
the browser's "Connection: Upgrade" therefore sent "Connection: Upgrade,
Upgrade" as its last line.

An HTTP/1.x request now sends the first custom Connection: header where the
application put it, as written, adding only the tokens it does not list
(compared per token, case-insensitively). Later custom Connection: headers
and requests without one are unchanged; the end-of-request path no longer
duplicates tokens either.

diff --git a/lib/http.c b/lib/http.c
index 145e34b..34ff05c 100644
--- a/lib/http.c
+++ b/lib/http.c
@@ -216,6 +216,97 @@ static CURLcode copy_custom_value(const char *header, char **valp)
   return CURLE_BAD_FUNCTION_ARGUMENT;
 }
 
+/* curl-impersonate: TRUE if the comma-separated header value lists 'token',
+   compared case-insensitively and without the surrounding blanks. */
+static bool http_value_has_token(const char *value, const char *token)
+{
+  size_t tlen = strlen(token);
+
+  while(*value) {
+    const char *start;
+    const char *end;
+
+    while(ISBLANK(*value) || *value == ',')
+      value++;
+    start = value;
+    while(*value && *value != ',')
+      value++;
+    end = value;
+    while(end > start && ISBLANK(end[-1]))
+      end--;
+    if(((size_t)(end - start) == tlen) && curl_strnequal(start, token, tlen))
+      return TRUE;
+  }
+  return FALSE;
+}
+
+/* The request's first custom Connection: header with a value, or NULL. */
+static const struct curl_slist *http_first_connection_hd(
+  const struct Curl_easy *data)
+{
+  const struct curl_slist *head;
+
+  for(head = Curl_http_request_headers(data); head; head = head->next) {
+    if(curl_strnequal(head->data, "Connection", 10) &&
+       Curl_headersep(head->data[10]) &&
+       !http_header_is_empty(head->data))
+      return head;
+  }
+  return NULL;
+}
+
+/* Add the Connection: tokens this request needs, each one only when 'value',
+   the application's own Connection: value or NULL, does not list it yet.
+   'sep' goes before the first token added. */
+static CURLcode http_add_connection_tokens(struct Curl_easy *data,
+                                           struct dynbuf *req,
+                                           const char *value,
+                                           const char *sep)
+{
+  CURLcode result = CURLE_OK;
+
+  if(data->state.http_hd_te &&
+     !(value && http_value_has_token(value, "TE"))) {
+    result = curlx_dyn_addf(req, "%s%s", sep, "TE");
+    sep = ", ";
+  }
+  if(!result && data->state.http_hd_upgrade &&
+     !(value && http_value_has_token(value, "Upgrade"))) {
+    result = curlx_dyn_addf(req, "%s%s", sep, "Upgrade");
+    sep = ", ";
+  }
+  if(!result && data->state.http_hd_h2_settings &&
+     !(value && http_value_has_token(value, "HTTP2-Settings")))
+    result = curlx_dyn_addf(req, "%s%s", sep, "HTTP2-Settings");
+  return result;
+}
+
+/* curl-impersonate: send the application's first Connection: header where
+   it put it among the custom headers, as it wrote it, plus the tokens the
+   request needs that it does not list. */
+static CURLcode http_add_first_connection_hd(struct Curl_easy *data,
+                                             struct dynbuf *req,
+                                             const char *line)
+{
+  size_t len = strlen(line);
+  char *value;
+  CURLcode result = copy_custom_value(line, &value);
+
+  if(result)
+    return result;
+  while(len && ISBLANK(line[len - 1]))
+    len--;
+  result = curlx_dyn_addn(req, line, len);
+  if(!result)
+    result = http_add_connection_tokens(data, req, value, ", ");
+  if(!result)
+    result = curlx_dyn_addn(req, STRCONST("\r\n"));
+  curlx_free(value);
+  if(!result)
+    data->state.http_hd_connection = TRUE;
+  return result;
+}
+
