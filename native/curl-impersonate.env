# Upstream curl-impersonate release the fork's libcurl-impersonate is built
# from. The patches in native/patches/<dependency>/ are applied on top of the
# matching patches/<dependency>.patch of that release.
CURL_IMPERSONATE_REPO=https://github.com/lexiforest/curl-impersonate.git
CURL_IMPERSONATE_REF=v2.2.3
CURL_IMPERSONATE_VERSION=2.2.3-bivis.3
ZIG_VERSION=0.15.2
